{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veridia.local/schemas/agent.schema.json",
  "title": "Veridia Agent Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "purpose",
    "triggers",
    "inputs",
    "outputs",
    "permissions",
    "actions_allowed",
    "human_approval_required",
    "observability",
    "rate_limits"
  ],
  "properties": {
    "name": {"type": "string", "pattern": "^agente-[a-z0-9-]+$"},
    "purpose": {"type": "string", "minLength": 10},
    "triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "permissions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"enum": ["read", "write", "create"]},
      "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
    },
    "actions_allowed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "human_approval_required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observability": {"type": "object", "minProperties": 1},
    "rate_limits": {"type": "object", "minProperties": 1},
    "retries": {"type": "object", "minProperties": 1},
    "provenance": {"type": "object", "minProperties": 1},
    "idempotency": {"type": "object", "minProperties": 1},
    "validation": {"type": "object", "minProperties": 1},
    "examples": {"type": "array", "minItems": 1},
    "code_style": {"type": "object", "minProperties": 1},
    "testing": {"type": "object", "minProperties": 1},
    "testing_frameworks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "security": {"type": "object", "minProperties": 1},
    "ci_config": {"type": "object", "minProperties": 1},
    "secrets": {"type": "object", "minProperties": 1},
    "notes": {"type": "string"}
  }
}
